1b:["$","$L4b",null,{"formats":"$undefined","locale":"fr","messages":{"Meta":{"title":"Digi-DZ — Logiciels de gestion sur mesure pour les entreprises algériennes","description":"Nous concevons et développons des systèmes de gestion sur mesure pour les showrooms automobiles, les cabinets médicaux et les entreprises en croissance en Algérie. Web, bureau et mobile, en français, arabe et anglais, avec WhatsApp intégré.","ogTagline":"Logiciels de gestion sur mesure pour les entreprises algériennes"},"Common":{"skip":"Aller au contenu","sampleData":"Aperçu de l'interface · données fictives","requestDemo":"Demander une démo","openMenu":"Ouvrir le menu","closeMenu":"Fermer le menu","language":"Langue","whatsappFab":"Discuter avec nous sur WhatsApp","waDefault":"Bonjour Digi-DZ, j'aimerais en savoir plus sur vos logiciels.","waDemo":"Bonjour Digi-DZ, j'aimerais une démo en direct de {product}."},"Nav":{"work":"Réalisations","services":"Services","process":"Méthode","faq":"FAQ","contact":"Contact"},"Hero":{"eyebrow":"Studio logiciel · Algérie","title":"Des logiciels de gestion pensés pour votre façon de travailler.","lead":"Digi-DZ conçoit et développe des systèmes sur mesure pour les entreprises algériennes — des showrooms automobiles aux cabinets médicaux. Web, bureau et mobile, en français, arabe et anglais, avec WhatsApp intégré.","ctaPrimary":"Voir nos réalisations","ctaSecondary":"Nous écrire sur WhatsApp","facts":{"platforms":"Web, Windows et Android","languages":"Français, arabe, anglais","offline":"Fonctionne hors connexion","onsite":"Installation et formation sur site"}},"Work":{"eyebrow":"Réalisations","title":"Les produits que nous avons construits","lead":"Deux systèmes opérationnels que nous adaptons à chaque client — et un bon aperçu de la manière dont nous aborderions votre projet.","caseStudy":"Voir l'étude de cas","liveDemo":"Demander une démo","custom":{"title":"Ni showroom, ni cabinet ?","text":"Beaucoup de projets partent d'une page blanche : un atelier, un distributeur, une école, une agence. Expliquez-nous comment vous travaillez aujourd'hui et nous vous montrerons à quoi pourrait ressembler votre système.","cta":"Décrire votre projet"}},"Projects":{"autodms":{"name":"AutoDMS","sector":"Showrooms automobiles","tagline":"Stock, arbouns, contrats et acheteurs — tout au même endroit.","summary":"Un logiciel de gestion pour les showrooms automobiles en Algérie : suivez chaque véhicule de l'achat à la vente, enregistrez les arbouns, imprimez des contrats bilingues et envoyez des devis aux acheteurs sur WhatsApp.","highlights":{"h1":"Fiche véhicule avec VIN, papiers et prix d'achat","h2":"Arbouns avec contrats bilingues imprimés","h3":"Fiches vitrine A4 avec QR code","h4":"Devis envoyés aux acheteurs sur WhatsApp en un clic"},"problem":"Les showrooms jonglent entre carnets, fichiers Excel et galeries photo du téléphone pour suivre leur stock. Les arbouns sont notés sur papier, les marges calculées à la main, et répondre à un acheteur sur WhatsApp oblige à chercher photos et prix.","solution":"AutoDMS donne au gérant et à l'équipe commerciale un seul outil de travail. Chaque véhicule a sa fiche — numéro de châssis, papiers de douane et carte grise, prix d'achat, photos et statut. Vendre, réserver ou imprimer un document se fait en quelques clics, et le gérant consulte la valeur du stock et ses marges à tout moment.","modules":{"m1":{"title":"Stock et fiches véhicules","text":"VIN, papiers, photos, prix d'achat et statut de chaque véhicule."},"m2":{"title":"Arbouns","text":"Enregistrez un arboun, imprimez le contrat et suivez le reste à payer."},"m3":{"title":"Ventes et marges","text":"Prix de vente, frais et marge par véhicule, par mois et par vendeur."},"m4":{"title":"Documents","text":"Contrats, factures et fiches vitrine en français et en arabe."},"m5":{"title":"Devis WhatsApp","text":"Envoyez la fiche, les photos et le prix d'un véhicule en un clic."},"m6":{"title":"Rôles et accès","text":"Gérant, vendeurs et comptabilité voient chacun ce dont ils ont besoin."}}},"clinicos":{"name":"ClinicOS","sector":"Cabinets médicaux","tagline":"Patients, rendez-vous et ordonnances — sans la paperasse.","summary":"Un logiciel de gestion pour les cliniques privées et les spécialistes : dossiers patients, salle d'attente en temps réel, ordonnances imprimées et rappels de rendez-vous automatiques sur WhatsApp.","highlights":{"h1":"Dossiers patients avec historique complet","h2":"Salle d'attente partagée entre accueil et médecin","h3":"Ordonnances imprimées en quelques secondes","h4":"Rappels de rendez-vous automatiques sur WhatsApp"},"problem":"Beaucoup de cabinets fonctionnent encore avec des dossiers papier et un agenda téléphonique. Retrouver l'historique d'un patient prend du temps, les ordonnances sont manuscrites et les rendez-vous manqués laissent des trous dans la journée.","solution":"ClinicOS relie l'accueil et la salle de consultation. La secrétaire prend les rendez-vous et enregistre les arrivées ; le médecin voit la file d'attente et le dossier complet, rédige l'ordonnance à partir d'une liste de médicaments et l'imprime sur l'en-tête du cabinet. Les patients reçoivent un rappel WhatsApp avant leur visite.","modules":{"m1":{"title":"Dossiers patients","text":"Antécédents, allergies, maladies chroniques, visites et documents."},"m2":{"title":"Rendez-vous","text":"Agenda du jour et de la semaine pour un ou plusieurs médecins."},"m3":{"title":"Salle d'attente","text":"Une file d'attente en direct partagée entre l'accueil et le médecin."},"m4":{"title":"Ordonnances","text":"Liste de médicaments avec posologies suggérées, imprimée sur votre en-tête."},"m5":{"title":"Rappels WhatsApp","text":"Les patients sont rappelés automatiquement avant leur rendez-vous."},"m6":{"title":"Paiements et rapports","text":"Honoraires, recette du jour et rapports d'activité."}}}},"Services":{"eyebrow":"Services","title":"Ce que nous construisons","lead":"Chaque projet est fait sur mesure. Voici les briques que nous assemblons le plus souvent.","items":{"systems":{"title":"Systèmes de gestion","text":"Stock, ventes, clients, personnel et rapports — le quotidien de votre entreprise dans un seul outil."},"desktop":{"title":"Logiciels de bureau hors ligne","text":"Des logiciels Windows avec base de données locale, qui continuent de tourner sans connexion et se synchronisent ensuite."},"webmobile":{"title":"Applications web et mobiles","text":"Des tableaux de bord accessibles depuis n'importe quel navigateur et des applications Android pour vos équipes sur le terrain."},"whatsapp":{"title":"Automatisation WhatsApp","text":"Devis, factures, confirmations et rappels envoyés automatiquement à vos clients."},"documents":{"title":"Documents et impression","text":"Contrats, factures, ordonnances et étiquettes en français et en arabe, sur votre en-tête."},"migration":{"title":"Migration et intégrations","text":"Nous reprenons vos fichiers Excel existants et connectons les outils que vous utilisez déjà."}}},"Local":{"eyebrow":"Pensé pour l'Algérie","title":"Conçu pour la réalité des entreprises d'ici","items":{"bilingual":{"title":"Français et arabe, côte à côte","text":"Écrans et documents imprimés dans les deux langues, avec une vraie mise en page de droite à gauche."},"formats":{"title":"Formats locaux","text":"Dinars, wilayas, numéros algériens et les documents que vos clients attendent."},"offline":{"title":"Connexion instable ? Aucun souci","text":"Les logiciels de bureau fonctionnent hors ligne et se synchronisent automatiquement."},"people":{"title":"Une équipe joignable","text":"Support sur WhatsApp, installation et formation sur site."}}},"Process":{"eyebrow":"Notre méthode","title":"Du premier appel à un outil que votre équipe utilise chaque jour","steps":{"discovery":{"title":"Découverte","text":"Un appel ou une visite pour comprendre votre fonctionnement. Vous recevez un périmètre, un planning et un devis écrits."},"prototype":{"title":"Prototype","text":"Vous voyez et testez les écrans principaux avant le début du développement."},"build":{"title":"Développement","text":"Nous avançons par cycles courts et vous montrons régulièrement l'avancement pour ajuster en cours de route."},"launch":{"title":"Mise en service et suivi","text":"Installation sur vos postes, formation de votre équipe et support après le lancement."}}},"Faq":{"eyebrow":"FAQ","title":"Les questions que l'on nous pose souvent","items":{"time":{"q":"Combien de temps prend un projet ?","a":"Cela dépend du périmètre. Adapter AutoDMS ou ClinicOS est bien plus rapide que partir de zéro. Après l'appel de découverte, vous recevez un planning écrit pour savoir à quoi vous attendre avant de vous engager."},"adapt":{"q":"Pouvez-vous adapter AutoDMS ou ClinicOS à mon activité ?","a":"Oui. Ce sont des points de départ, pas des packs figés : écrans, documents, rôles et circuits de travail sont ajustés à votre façon de travailler."},"offline":{"q":"Est-ce que ça fonctionne sans internet ?","a":"Les versions bureau continuent de fonctionner hors ligne et se synchronisent dès que la connexion revient. Les tableaux de bord web nécessitent une connexion."},"data":{"q":"Où sont stockées mes données ?","a":"Sur vos propres ordinateurs, sur un serveur de votre choix, ou les deux. Nous choisissons ensemble la bonne configuration pendant la phase de découverte."},"after":{"q":"Que se passe-t-il après la livraison ?","a":"Nous installons le système, formons votre équipe et restons disponibles pour les questions, les corrections et les évolutions."},"where":{"q":"Travaillez-vous en dehors d'Alger ?","a":"Oui. Nous travaillons à distance avec des entreprises dans toute l'Algérie et nous déplaçons pour l'installation et la formation si nécessaire."}}},"Cta":{"title":"Une partie de votre activité tourne encore sur papier ou sur Excel ?","text":"C'est souvent là que naissent les outils les plus utiles. Parlons-en.","button":"Lancer la discussion"},"Contact":{"eyebrow":"Contact","title":"Parlez-nous de votre activité","lead":"Remplissez quelques champs et nous vous répondrons sur WhatsApp. Vous préférez appeler ou écrire ? Utilisez les coordonnées ci-dessous.","channels":{"whatsapp":"WhatsApp","phone":"Téléphone","email":"E-mail","area":"Zone","areaValue":"Basés en Algérie, nous intervenons dans toutes les wilayas"},"form":{"name":"Votre nom ou entreprise","namePlaceholder":"ex. Auto Prestige Sétif","nameError":"Indiquez votre nom ou celui de votre entreprise.","phone":"Téléphone","phonePlaceholder":"0555 12 34 56","city":"Ville / wilaya","cityPlaceholder":"ex. Oran","optional":"facultatif","need":"De quoi avez-vous besoin ?","needs":{"autodms":"Logiciel showroom","clinicos":"Logiciel cabinet","custom":"Projet sur mesure"},"message":"Quelque chose à préciser ?","messagePlaceholder":"Votre fonctionnement actuel, nombre d'utilisateurs, délais…","submit":"Envoyer sur WhatsApp","email":"Envoyer plutôt par e-mail","hint":"WhatsApp s'ouvre avec votre message prêt — il suffit d'appuyer sur Envoyer."},"message":{"greeting":"Bonjour Digi-DZ,","intro":"J'aimerais discuter de : {need}","name":"Nom / entreprise : {value}","phone":"Téléphone : {value}","city":"Ville : {value}","details":"Détails : {value}","subject":"Demande de projet — {need}"}},"CaseStudy":{"back":"Toutes les réalisations","problemTitle":"Le problème","solutionTitle":"Ce que nous avons construit","modulesTitle":"Modules principaux","platformsTitle":"Plateformes","platforms":"Windows (hors ligne) · Tableau de bord web · Android","languagesTitle":"Langues","languages":"Français · Arabe","ctaTitle":"Envie de voir {product} avec vos propres données ?","ctaText":"Nous vous le présentons en direct et vous montrons comment l'adapter à votre activité.","otherWork":"Autre réalisation"},"Footer":{"tagline":"Logiciels de gestion sur mesure pour les entreprises algériennes.","studio":"Studio","work":"Réalisations","contact":"Contact","rights":"Tous droits réservés."},"NotFound":{"title":"Page introuvable","text":"La page que vous cherchez n'existe pas ou a été déplacée.","back":"Retour à l'accueil"}},"now":"$undefined","timeZone":"Europe/London","children":["$L4c","$L4d","$L4e","$L4f","$L50"]}]
