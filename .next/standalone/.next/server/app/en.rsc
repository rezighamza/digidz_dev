1b:["$","$L49",null,{"formats":"$undefined","locale":"en","messages":{"Meta":{"title":"Digi-DZ — Custom management software for Algerian businesses","description":"We design and build custom management systems for car showrooms, medical clinics and growing businesses in Algeria. Web, desktop and mobile, in French, Arabic and English, with WhatsApp built in.","ogTagline":"Custom management software for Algerian businesses"},"Common":{"skip":"Skip to content","sampleData":"Interface preview · sample data","requestDemo":"Request a demo","openMenu":"Open menu","closeMenu":"Close menu","language":"Language","whatsappFab":"Chat with us on WhatsApp","waDefault":"Hello Digi-DZ, I'd like to know more about your software.","waDemo":"Hello Digi-DZ, I'd like a live demo of {product}."},"Nav":{"work":"Work","services":"Services","process":"Process","faq":"FAQ","contact":"Contact"},"Hero":{"eyebrow":"Software studio · Algeria","title":"Management software built around the way your business works.","lead":"Digi-DZ designs and builds custom systems for Algerian businesses — from car showrooms to medical clinics. Web, desktop and mobile, in French, Arabic and English, with WhatsApp built in.","ctaPrimary":"See our work","ctaSecondary":"Message us on WhatsApp","facts":{"platforms":"Web, Windows & Android","languages":"French, Arabic, English","offline":"Keeps working offline","onsite":"On-site setup & training"}},"Work":{"eyebrow":"Selected work","title":"Products we've built","lead":"Both are working systems that we adapt to each client — and a good picture of how we would approach yours.","caseStudy":"Read the case study","liveDemo":"Ask for a live demo","custom":{"title":"Not a showroom or a clinic?","text":"Many projects start from a blank page: a workshop, a distributor, a school, an agency. Tell us how you work today and we'll show you what a system for it could look like.","cta":"Describe your project"}},"Projects":{"autodms":{"name":"AutoDMS","sector":"Car showrooms","tagline":"Stock, deposits, contracts and buyers — managed in one place.","summary":"A dealer management system for Algerian car showrooms: follow every vehicle from purchase to sale, record arboun deposits, print bilingual contracts and send quotes to buyers on WhatsApp.","highlights":{"h1":"Vehicle files with VIN, papers and purchase cost","h2":"Arboun deposits with printed bilingual contracts","h3":"A4 window sheets with a QR code","h4":"One-click quotes sent to buyers on WhatsApp"},"problem":"Showrooms juggle notebooks, Excel files and phone galleries to keep track of their stock. Deposits are written on paper, margins are worked out by hand, and answering a buyer on WhatsApp means hunting for photos and prices.","solution":"AutoDMS gives the owner and the sales team one place to work. Every vehicle has its file — chassis number, customs and registration papers, purchase cost, photos and status. Selling, reserving or printing a document takes a few clicks, and the owner can check stock value and margins at any time.","modules":{"m1":{"title":"Stock & vehicle files","text":"VIN, papers, photos, purchase cost and status for every vehicle."},"m2":{"title":"Deposits (arboun)","text":"Record a deposit, print the contract and follow the remaining balance."},"m3":{"title":"Sales & margins","text":"Sale price, costs and margin per vehicle, per month and per seller."},"m4":{"title":"Documents","text":"Contracts, invoices and window sheets in French and Arabic."},"m5":{"title":"WhatsApp quotes","text":"Send a vehicle's specs, photos and price to a buyer in one click."},"m6":{"title":"Roles & access","text":"Owner, sales and accounting each see what they need."}}},"clinicos":{"name":"ClinicOS","sector":"Medical practices","tagline":"Patients, appointments and prescriptions — without the paperwork.","summary":"A practice management system for private clinics and specialists: patient records, a live waiting-room queue, printed prescriptions and automatic WhatsApp appointment reminders.","highlights":{"h1":"Patient records with full history","h2":"Waiting room shared by reception and doctor","h3":"Prescriptions printed in seconds","h4":"Automatic appointment reminders on WhatsApp"},"problem":"Many practices still run on paper files and a phone diary. Finding a patient's history takes time, prescriptions are handwritten, and missed appointments leave gaps in the day.","solution":"ClinicOS connects reception and the consultation room. The secretary books and checks patients in; the doctor sees the queue and the full patient file, writes the prescription from a drug list and prints it on the practice letterhead. Patients get a WhatsApp reminder before their visit.","modules":{"m1":{"title":"Patient records","text":"History, allergies, chronic conditions, past visits and documents."},"m2":{"title":"Appointments","text":"Daily and weekly agenda for one or several doctors."},"m3":{"title":"Waiting room","text":"A live queue shared between reception and the consultation room."},"m4":{"title":"Prescriptions","text":"Drug list with dosage suggestions, printed on your letterhead."},"m5":{"title":"WhatsApp reminders","text":"Patients are reminded automatically before their appointment."},"m6":{"title":"Payments & reports","text":"Consultation fees, daily takings and activity reports."}}}},"Services":{"eyebrow":"Services","title":"What we build","lead":"Every project is made to measure. These are the building blocks we put together most often.","items":{"systems":{"title":"Management systems","text":"Stock, sales, clients, staff and reports — the day-to-day of your business in one system."},"desktop":{"title":"Desktop apps that work offline","text":"Windows software with a local database that keeps running when the connection drops and syncs when it's back."},"webmobile":{"title":"Web & mobile apps","text":"Dashboards you open from any browser, and Android apps for your team on the move."},"whatsapp":{"title":"WhatsApp automation","text":"Quotes, invoices, confirmations and reminders sent to your customers automatically."},"documents":{"title":"Documents & printing","text":"Contracts, invoices, prescriptions and labels in French and Arabic, on your letterhead."},"migration":{"title":"Migration & integrations","text":"We bring in your existing Excel files and connect the tools you already use."}}},"Local":{"eyebrow":"Made for Algeria","title":"Built for the way business works here","items":{"bilingual":{"title":"French & Arabic, side by side","text":"Screens and printed documents in both languages, with proper right-to-left layout."},"formats":{"title":"Local formats","text":"Dinars, wilayas, Algerian phone numbers and the documents your customers expect."},"offline":{"title":"Unstable connection? No problem","text":"Desktop systems keep running offline and catch up automatically."},"people":{"title":"A team you can reach","text":"Support on WhatsApp, with on-site installation and training."}}},"Process":{"eyebrow":"How we work","title":"From the first call to a system your team uses every day","steps":{"discovery":{"title":"Discovery","text":"A call or a visit to understand how you work. You receive a written scope, timeline and quote."},"prototype":{"title":"Prototype","text":"You see and click through the main screens before development starts."},"build":{"title":"Build","text":"We build in short cycles and show you progress regularly, so you can adjust along the way."},"launch":{"title":"Launch & support","text":"Installation on your machines, training for your team and support after go-live."}}},"Faq":{"eyebrow":"FAQ","title":"Questions clients usually ask","items":{"time":{"q":"How long does a project take?","a":"It depends on the scope. Adapting AutoDMS or ClinicOS is much faster than building from scratch. After the discovery call you get a written timeline, so you know what to expect before you commit."},"adapt":{"q":"Can you adapt AutoDMS or ClinicOS to my business?","a":"Yes. They are starting points, not fixed packages: screens, documents, roles and workflows are adjusted to match the way you already work."},"offline":{"q":"Does it work without internet?","a":"The desktop versions keep working offline and sync automatically once the connection is back. Web dashboards need a connection."},"data":{"q":"Where is my data stored?","a":"On your own computers, on a server you choose, or both. We discuss the right setup for your business during discovery."},"after":{"q":"What happens after delivery?","a":"We install the system, train your team and stay available for questions, fixes and new features."},"where":{"q":"Do you work outside Algiers?","a":"Yes. We work remotely with businesses across Algeria and travel for installation and training when needed."}}},"Cta":{"title":"Is part of your business still running on paper or Excel?","text":"That's usually where the most useful systems start. Let's talk about it.","button":"Start a conversation"},"Contact":{"eyebrow":"Contact","title":"Tell us about your business","lead":"Fill in a few details and we'll get back to you on WhatsApp. Prefer to call or email? Use the details below.","channels":{"whatsapp":"WhatsApp","phone":"Phone","email":"Email","area":"Area","areaValue":"Based in Algeria, working in every wilaya"},"form":{"name":"Your name or business","namePlaceholder":"e.g. Auto Prestige Sétif","nameError":"Please tell us your name or the name of your business.","phone":"Phone","phonePlaceholder":"0555 12 34 56","city":"City / wilaya","cityPlaceholder":"e.g. Oran","optional":"optional","need":"What do you need?","needs":{"autodms":"Showroom software","clinicos":"Clinic software","custom":"Custom project"},"message":"Anything we should know?","messagePlaceholder":"How you work today, number of users, deadlines…","submit":"Send on WhatsApp","email":"Send by email instead","hint":"WhatsApp opens with your message ready — just press send."},"message":{"greeting":"Hello Digi-DZ,","intro":"I'd like to talk about: {need}","name":"Name / business: {value}","phone":"Phone: {value}","city":"City: {value}","details":"Details: {value}","subject":"Project enquiry — {need}"}},"CaseStudy":{"back":"All work","problemTitle":"The problem","solutionTitle":"What we built","modulesTitle":"Key modules","platformsTitle":"Platforms","platforms":"Windows desktop (works offline) · Web dashboard · Android","languagesTitle":"Languages","languages":"French · Arabic","ctaTitle":"Want to see {product} with your own data?","ctaText":"We'll walk you through it live and show how it can be adapted to your business.","otherWork":"Other work"},"Footer":{"tagline":"Custom management software for Algerian businesses.","studio":"Studio","work":"Work","contact":"Contact","rights":"All rights reserved."},"NotFound":{"title":"Page not found","text":"The page you're looking for doesn't exist or has moved.","back":"Back to home"}},"now":"$undefined","timeZone":"Europe/London","children":["$L4a","$L4b","$L4c","$L4d","$L4e"]}]
