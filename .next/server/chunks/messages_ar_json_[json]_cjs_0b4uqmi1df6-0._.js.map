{"Meta":{"title":"Digi-DZ — برمجيات تسيير مصممة حسب الطلب للمؤسسات الجزائرية","description":"نصمم ونطور أنظمة تسيير حسب الطلب لمعارض السيارات والعيادات الطبية والمؤسسات النامية في الجزائر. على الويب والحاسوب والهاتف، بالفرنسية والعربية والإنجليزية، مع ربط مباشر بواتساب.","ogTagline":"برمجيات تسيير حسب الطلب للمؤسسات الجزائرية"},"Common":{"skip":"انتقل إلى المحتوى","sampleData":"معاينة الواجهة · بيانات توضيحية","requestDemo":"اطلب عرضًا توضيحيًا","openMenu":"فتح القائمة","closeMenu":"إغلاق القائمة","language":"اللغة","whatsappFab":"تواصل معنا عبر واتساب","waDefault":"السلام عليكم Digi-DZ، أود معرفة المزيد عن برمجياتكم.","waDemo":"السلام عليكم Digi-DZ، أود مشاهدة عرض مباشر لـ {product}."},"Nav":{"work":"أعمالنا","services":"الخدمات","process":"طريقة العمل","faq":"الأسئلة الشائعة","contact":"اتصل بنا"},"Hero":{"eyebrow":"استوديو برمجيات · الجزائر","title":"برمجيات تسيير مبنية على طريقة عمل مؤسستك.","lead":"تصمم Digi-DZ وتطور أنظمة حسب الطلب للمؤسسات الجزائرية — من معارض السيارات إلى العيادات الطبية. على الويب والحاسوب والهاتف، بالفرنسية والعربية والإنجليزية، مع ربط مباشر بواتساب.","ctaPrimary":"شاهد أعمالنا","ctaSecondary":"راسلنا على واتساب","facts":{"platforms":"ويب، ويندوز وأندرويد","languages":"الفرنسية، العربية، الإنجليزية","offline":"يعمل دون إنترنت","onsite":"تركيب وتكوين في عين المكان"}},"Work":{"eyebrow":"أعمال مختارة","title":"منتجات قمنا ببنائها","lead":"نظامان قيد التشغيل نكيّفهما مع كل عميل — وصورة واضحة عن طريقتنا في التعامل مع مشروعك.","caseStudy":"اقرأ دراسة الحالة","liveDemo":"اطلب عرضًا مباشرًا","custom":{"title":"لست معرض سيارات ولا عيادة؟","text":"كثير من المشاريع تبدأ من الصفر: ورشة، موزع، مدرسة، وكالة. أخبرنا كيف تعمل اليوم وسنريك كيف يمكن أن يبدو نظامك.","cta":"صف لنا مشروعك"}},"Projects":{"autodms":{"name":"AutoDMS","sector":"معارض السيارات","tagline":"المخزون والعرابين والعقود والزبائن — في مكان واحد.","summary":"نظام تسيير لمعارض السيارات في الجزائر: تابع كل سيارة من الشراء إلى البيع، سجّل العرابين، اطبع عقودًا ثنائية اللغة وأرسل عروض الأسعار للزبائن عبر واتساب.","highlights":{"h1":"ملف لكل سيارة برقم الهيكل والوثائق وسعر الشراء","h2":"تسيير العرابين مع عقود مطبوعة باللغتين","h3":"بطاقات عرض A4 مع رمز QR","h4":"إرسال عروض الأسعار للزبائن عبر واتساب بنقرة واحدة"},"problem":"تعتمد المعارض على الدفاتر وملفات Excel وصور الهاتف لمتابعة مخزونها. تُكتب العرابين على الورق وتُحسب الأرباح يدويًا، والرد على زبون عبر واتساب يعني البحث عن الصور والأسعار في كل مرة.","solution":"يمنح AutoDMS المالك وفريق البيع أداة عمل واحدة. لكل سيارة ملفها — رقم الهيكل، وثائق الجمارك والبطاقة الرمادية، سعر الشراء، الصور والحالة. البيع أو الحجز أو طباعة وثيقة يتم ببضع نقرات، ويستطيع المالك الاطلاع على قيمة المخزون والأرباح في أي وقت.","modules":{"m1":{"title":"المخزون وملفات السيارات","text":"رقم الهيكل، الوثائق، الصور، سعر الشراء وحالة كل سيارة."},"m2":{"title":"العرابين","text":"سجّل العربون، اطبع العقد وتابع المبلغ المتبقي."},"m3":{"title":"المبيعات والأرباح","text":"سعر البيع والمصاريف والربح لكل سيارة، لكل شهر ولكل بائع."},"m4":{"title":"الوثائق","text":"عقود وفواتير وبطاقات عرض بالفرنسية والعربية."},"m5":{"title":"عروض الأسعار عبر واتساب","text":"أرسل مواصفات السيارة وصورها وسعرها للزبون بنقرة واحدة."},"m6":{"title":"الأدوار والصلاحيات","text":"المالك والبائعون والمحاسبة، كلٌّ يرى ما يحتاجه."}}},"clinicos":{"name":"ClinicOS","sector":"العيادات الطبية","tagline":"المرضى والمواعيد والوصفات — دون أوراق.","summary":"نظام تسيير للعيادات الخاصة والأطباء المختصين: ملفات المرضى، قاعة انتظار مباشرة، وصفات طبية مطبوعة وتذكير آلي بالمواعيد عبر واتساب.","highlights":{"h1":"ملفات المرضى مع السجل الكامل","h2":"قاعة انتظار مشتركة بين الاستقبال والطبيب","h3":"وصفات طبية تُطبع في ثوانٍ","h4":"تذكير آلي بالمواعيد عبر واتساب"},"problem":"لا تزال كثير من العيادات تعمل بملفات ورقية ومفكرة هاتفية. إيجاد سجل مريض يستغرق وقتًا، والوصفات تُكتب باليد، والمواعيد الفائتة تترك فراغات في اليوم.","solution":"يربط ClinicOS بين الاستقبال وغرفة الفحص. تحجز السكرتيرة المواعيد وتسجل وصول المرضى، ويرى الطبيب قائمة الانتظار والملف الكامل للمريض، ويحرر الوصفة من قائمة الأدوية ويطبعها على ترويسة العيادة. ويتلقى المرضى تذكيرًا عبر واتساب قبل موعدهم.","modules":{"m1":{"title":"ملفات المرضى","text":"السوابق، الحساسية، الأمراض المزمنة، الزيارات السابقة والوثائق."},"m2":{"title":"المواعيد","text":"جدول يومي وأسبوعي لطبيب واحد أو عدة أطباء."},"m3":{"title":"قاعة الانتظار","text":"قائمة انتظار مباشرة مشتركة بين الاستقبال وغرفة الفحص."},"m4":{"title":"الوصفات الطبية","text":"قائمة أدوية مع جرعات مقترحة، تُطبع على ترويسة عيادتك."},"m5":{"title":"تذكير عبر واتساب","text":"يتلقى المرضى تذكيرًا آليًا قبل موعدهم."},"m6":{"title":"المدفوعات والتقارير","text":"أتعاب الفحص، مداخيل اليوم وتقارير النشاط."}}}},"Services":{"eyebrow":"الخدمات","title":"ماذا نبني","lead":"كل مشروع يُصمم حسب الطلب. هذه هي العناصر التي نجمعها في أغلب الأحيان.","items":{"systems":{"title":"أنظمة التسيير","text":"المخزون، المبيعات، الزبائن، الموظفون والتقارير — يوميات مؤسستك في نظام واحد."},"desktop":{"title":"برامج حاسوب تعمل دون إنترنت","text":"برامج ويندوز بقاعدة بيانات محلية تواصل العمل عند انقطاع الاتصال وتتزامن عند عودته."},"webmobile":{"title":"تطبيقات الويب والهاتف","text":"لوحات متابعة تفتحها من أي متصفح، وتطبيقات أندرويد لفريقك في الميدان."},"whatsapp":{"title":"أتمتة واتساب","text":"عروض الأسعار والفواتير والتأكيدات والتذكيرات تُرسل لزبائنك آليًا."},"documents":{"title":"الوثائق والطباعة","text":"عقود وفواتير ووصفات وملصقات بالفرنسية والعربية، على ترويستك."},"migration":{"title":"نقل البيانات والربط","text":"ننقل ملفات Excel الحالية ونربط الأدوات التي تستعملها بالفعل."}}},"Local":{"eyebrow":"مصمم للجزائر","title":"مبني على واقع المؤسسات هنا","items":{"bilingual":{"title":"الفرنسية والعربية جنبًا إلى جنب","text":"شاشات ووثائق مطبوعة باللغتين، مع تخطيط صحيح من اليمين إلى اليسار."},"formats":{"title":"صيغ محلية","text":"الدينار، الولايات، أرقام الهاتف الجزائرية والوثائق التي ينتظرها زبائنك."},"offline":{"title":"اتصال غير مستقر؟ لا مشكلة","text":"برامج الحاسوب تعمل دون إنترنت وتتزامن تلقائيًا."},"people":{"title":"فريق يمكنك الوصول إليه","text":"دعم عبر واتساب، مع التركيب والتكوين في عين المكان."}}},"Process":{"eyebrow":"طريقة عملنا","title":"من أول مكالمة إلى نظام يستعمله فريقك كل يوم","steps":{"discovery":{"title":"الاستكشاف","text":"مكالمة أو زيارة لفهم طريقة عملك. تتلقى نطاق العمل والجدول الزمني والسعر مكتوبة."},"prototype":{"title":"النموذج الأولي","text":"تشاهد الشاشات الرئيسية وتجربها قبل بدء التطوير."},"build":{"title":"التطوير","text":"نعمل على مراحل قصيرة ونعرض عليك التقدم بانتظام لتعدّل خلال الطريق."},"launch":{"title":"الإطلاق والمتابعة","text":"التركيب على أجهزتك، تكوين فريقك والدعم بعد الانطلاق."}}},"Faq":{"eyebrow":"الأسئلة الشائعة","title":"أسئلة يطرحها علينا العملاء عادة","items":{"time":{"q":"كم يستغرق المشروع؟","a":"يعتمد ذلك على حجم العمل. تكييف AutoDMS أو ClinicOS أسرع بكثير من البناء من الصفر. بعد مكالمة الاستكشاف تتلقى جدولًا زمنيًا مكتوبًا لتعرف ما تنتظره قبل الالتزام."},"adapt":{"q":"هل يمكنكم تكييف AutoDMS أو ClinicOS مع نشاطي؟","a":"نعم. هما نقطة انطلاق وليسا حزمة جامدة: الشاشات والوثائق والأدوار ومسارات العمل تُكيَّف حسب طريقة عملك."},"offline":{"q":"هل يعمل دون إنترنت؟","a":"نسخ الحاسوب تواصل العمل دون اتصال وتتزامن تلقائيًا عند عودته. أما لوحات الويب فتحتاج إلى اتصال."},"data":{"q":"أين تُخزَّن بياناتي؟","a":"على حواسيبك، أو على خادم تختاره، أو على الاثنين معًا. نختار معك الإعداد المناسب خلال مرحلة الاستكشاف."},"after":{"q":"ماذا يحدث بعد التسليم؟","a":"نركّب النظام، نكوّن فريقك ونبقى متاحين للأسئلة والتصحيحات والإضافات الجديدة."},"where":{"q":"هل تعملون خارج الجزائر العاصمة؟","a":"نعم. نعمل عن بعد مع مؤسسات في كامل التراب الوطني ونتنقل للتركيب والتكوين عند الحاجة."}}},"Cta":{"title":"هل لا يزال جزء من عملك يسير على الورق أو Excel؟","text":"من هناك تبدأ عادةً أنفع الأنظمة. لنتحدث عن ذلك.","button":"ابدأ المحادثة"},"Contact":{"eyebrow":"اتصل بنا","title":"حدثنا عن مؤسستك","lead":"املأ بعض المعلومات وسنرد عليك عبر واتساب. تفضّل الاتصال أو البريد الإلكتروني؟ استعمل المعلومات أدناه.","channels":{"whatsapp":"واتساب","phone":"الهاتف","email":"البريد الإلكتروني","area":"منطقة العمل","areaValue":"مقرنا في الجزائر ونعمل في كل الولايات"},"form":{"name":"اسمك أو اسم مؤسستك","namePlaceholder":"مثال: Auto Prestige سطيف","nameError":"يرجى كتابة اسمك أو اسم مؤسستك.","phone":"الهاتف","phonePlaceholder":"0555 12 34 56","city":"المدينة / الولاية","cityPlaceholder":"مثال: وهران","optional":"اختياري","need":"ماذا تحتاج؟","needs":{"autodms":"نظام معرض سيارات","clinicos":"نظام عيادة","custom":"مشروع حسب الطلب"},"message":"هل هناك ما يجب أن نعرفه؟","messagePlaceholder":"طريقة عملك الحالية، عدد المستخدمين، الآجال…","submit":"أرسل عبر واتساب","email":"أو أرسل عبر البريد الإلكتروني","hint":"يُفتح واتساب ورسالتك جاهزة — ما عليك سوى الضغط على إرسال."},"message":{"greeting":"السلام عليكم Digi-DZ،","intro":"أود التحدث عن: {need}","name":"الاسم / المؤسسة: {value}","phone":"الهاتف: {value}","city":"المدينة: {value}","details":"تفاصيل: {value}","subject":"طلب مشروع — {need}"}},"CaseStudy":{"back":"كل الأعمال","problemTitle":"المشكلة","solutionTitle":"ما قمنا ببنائه","modulesTitle":"الوحدات الرئيسية","platformsTitle":"المنصات","platforms":"ويندوز (دون إنترنت) · لوحة ويب · أندرويد","languagesTitle":"اللغات","languages":"الفرنسية · العربية","ctaTitle":"هل تريد رؤية {product} ببياناتك الخاصة؟","ctaText":"سنعرضه عليك مباشرة ونريك كيف يمكن تكييفه مع نشاطك.","otherWork":"عمل آخر"},"Footer":{"tagline":"برمجيات تسيير حسب الطلب للمؤسسات الجزائرية.","studio":"الاستوديو","work":"أعمالنا","contact":"اتصل بنا","rights":"جميع الحقوق محفوظة."},"NotFound":{"title":"الصفحة غير موجودة","text":"الصفحة التي تبحث عنها غير موجودة أو تم نقلها.","back":"العودة إلى الرئيسية"}}